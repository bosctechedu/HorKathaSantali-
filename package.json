{
  "name": "horkathasantali",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "check:questions": "esbuild scripts/check-question-dupes.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-questions.mjs --log-level=warning && node node_modules/.cache/check-questions.mjs",
    "test:content": "esbuild scripts/test-content.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-content.mjs --log-level=warning && node node_modules/.cache/test-content.mjs",
    "test:auth": "esbuild scripts/test-auth.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-auth.mjs --log-level=warning && node node_modules/.cache/test-auth.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
